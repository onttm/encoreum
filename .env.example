# =============================================================================
# concert-dl — copy to .env and fill in.  `cp .env.example .env`
#
# .env is gitignored. Keep it chmod 600: it holds two API credentials.
# Everything here is OPTIONAL except MEDIADIR1 — with no integrations
# configured the app still downloads and files concerts exactly as before;
# only the artist-lookup extras go quiet.
#
# After editing:   docker compose up -d
# Then check it:   curl localhost:8681/api/queue/integrations
#                  (or the "Integrations" panel in the web UI)
# =============================================================================

# --- required ----------------------------------------------------------------
# Media library root, mounted at /library in the container.
# Mirrors $MEDIADIR1 from the the host stack.
MEDIADIR1=/mnt/nas/media

# --- Podcast preset ------------------------------------------------------------
# A SEPARATE top-level path (not under $MEDIADIR1, unlike the Audiobook and
# Music-library presets) -- docker-compose.yml nests it inside the /library
# mount at /library/podcasts, so it needs no ALLOWED_ROOTS change. Optional:
# only the Podcast preset's destination needs this; everything else works
# without it.
PODCASTSDIR=/mnt/nas/podcasts


# --- Lidarr: artist identity and genre ---------------------------------------
# Used to answer "who is this festival act, and what do they sound like".
# Lidarr proxies MusicBrainz, so this works for artists you do NOT own — which
# is most of a festival lineup. It also supplies the disambiguation that
# separates "Band C (American rock band)" from "Band C (90s trance DJ)".
#
# Key: Lidarr > Settings > General > Security > API Key
# URL: from inside a container, the host is 172.17.0.1 — NOT localhost, which
#      would resolve to the concert-dl container itself.
LIDARR_URL=http://172.17.0.1:8686
LIDARR_API_KEY=

# --- Plex: what the library already holds ------------------------------------
# One /hubs/search call answers audio + music video + concerts, so the set list
# can say "5 albums, no live footage" — the line that decides whether a set is
# worth recording.
#
# Token: Plex Preferences.xml -> PlexOnlineToken, or
#        https://support.plex.tv/articles/204059436-finding-an-authentication-token/
#        Treat it as a password: it is a Plex ACCOUNT credential, not server-scoped.
PLEX_URL=http://172.17.0.1:32400
PLEX_TOKEN=

# How the server is named in the UI. The library is shared, so output reads
# "My Plex has 5 albums" rather than "you own 5 albums" — true whoever looks.
LIBRARY_NAME=My Plex


# --- taper uploads -----------------------------------------------------------
# Where you drop hand-collected archives (a folder or a .zip) for Encoreum to
# tag. Scanned every 10 minutes; a drop still being copied is left alone until
# it stops growing.
#
# NOTHING HERE IS AUTO-IMPORTED. A manual upload always waits for you to look at
# the proposed match and approve it — that is a code invariant, not a setting.
# Only captures this app scheduled and ran itself can import unattended, and
# only when the track mapping is exact.
INGEST_DIR=./ingest

# The separate Live Music audio library approved uploads are written into. Kept
# apart from studio albums so shuffle and PlexAmp DJing are not derailed by
# live tracks.
LIVE_AUDIO_DIR=/library/live-music


# --- setlist.fm: song-by-song metadata, when it exists ------------------------
# OPTIONAL, and the app is fully functional without it.
#
# A festival set is recorded while it airs, and nobody has posted its setlist
# yet — setlists are written up afterwards, hours to days later, and many sets
# never get one at all. So metadata arrives in two stages: everything the app
# knew when it pressed record goes in immediately, and a setlist is attached
# later IF one appears.
#
# With a key   lookups run hourly on a widening retry schedule, then stop.
# Without one  captures keep their basic metadata and you can paste a setlist
#              in by hand at any time. Nothing is blocked, nothing breaks.
#
# Key: https://api.setlist.fm/docs/1.0/index.html (free, non-commercial use).
# setlist.fm's PUBLISHED limits are max 2.0 requests/second and max 1,440/day
# (shown on setlist.fm/settings/api once you are logged in — the public docs
# state no figures). Our own budget sits under theirs so we trip our ceiling
# first: a self-imposed cap that the vendor's can exceed is not a margin.
# All services' limits are declared in app/ratelimit.py, visible at
# GET /api/ratelimits.
#
# The cap is a rolling 24h window and is persisted, so restarting the container
# does not hand the app a fresh allowance. Spending it is not an error: lookups
# pause and resume as the window moves, and pasting a setlist still works.
# Prefer the docker secret (see docker-compose.yml) over this variable: an env
# var shows up in `docker inspect` and is inherited by every child process, and
# this app spawns yt-dlp and streamlink as children.
SETLISTFM_API_KEY=
# SETLISTFM_MIN_INTERVAL=1      # seconds between calls (their ceiling: 2/sec)
# SETLISTFM_DAILY_CAP=1200      # rolling 24h budget (their ceiling: 1440/day)


# --- auth --------------------------------------------------------------------
# !! SET THIS TO 1 BEFORE EXPOSING THE APP BEYOND YOUR LAN !!
# Identity comes from Authentik's forward-auth headers. While this is unset, a
# request arriving with NO headers is treated as an ADMIN — correct for a
# LAN-only install, and a hole the moment the app is reachable any other way.
CONCERT_DL_REQUIRE_AUTH=

# --- Page audio capture (optional) -------------------------------------------
# Private addresses are blocked, since a web page is untrusted input. List your
# own servers to allow them, for jobs whose page is on this list. '.example.com'
# also matches subdomains. For Plex: your server's LAN IP plus .plex.direct.
# PAGE_CAPTURE_ALLOW_HOSTS=192.168.0.10,.plex.direct
#
# Chromium's sandbox usually can't start under Docker's default confinement, and
# capture then fails with a clear error. Setting this runs the browser without
# it. Read "Page audio capture" in the README first: a browser exploit in a
# captured page would reach everything this container can.
# CHROMIUM_NO_SANDBOX=1

# --- Secrets (see docs/docker-secrets-notes.md) --------------------------------
# Folder holding encoreum_plex_token, encoreum_lidarr_api_key and
# encoreum_setlist_fm_api_key (each optional; an empty file = not configured).
# SECRETS_DIR=./secrets
# The gid of the group that owns those files (root:<group> 0640), so the
# container's user can read them without being root.
# SECRET_GID=985
